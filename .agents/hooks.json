{
  "postCommitReminder": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f ../scripts/hooks/post-commit-reminder.sh ] || ../scripts/hooks/post-commit-reminder.sh --antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
