{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit -p .)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx jest *)",
      "Bash(npm run verify:ui)",
      "Bash(npm run docs:generate)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/apikeys/**)",
      "Read(**/.vercel/**)",
      "Read(**/output/**)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-commit-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
