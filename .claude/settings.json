{
  "permissions": {
    "allow": [
      "Bash(scripts/check-all.sh*)",
      "Bash(./scripts/check-all.sh*)",
      "Bash(npm --prefix backend run typecheck)",
      "Bash(npm --prefix backend run typecheck:test)",
      "Bash(npm --prefix backend run lint)",
      "Bash(npm --prefix backend run lint:fix)",
      "Bash(npm --prefix backend run build)",
      "Bash(npm --prefix backend run docs:generate)",
      "Bash(npm --prefix backend run docs:check)",
      "Bash(npm --prefix backend run check:all)",
      "Bash(npm --prefix backend test*)",
      "Bash(npm --prefix frontend run *)",
      "Bash(npm --prefix frontend test*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/apikeys/**)",
      "Read(**/.vercel/**)",
      "Read(**/output/**)",
      "Read(./backend/.env*)",
      "Read(./backend/apikeys/**)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-commit-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
