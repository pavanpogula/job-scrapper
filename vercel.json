{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "job-scrapper-ui/dist",
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
