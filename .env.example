# Database - Required
# Neon PostgreSQL or any PostgreSQL instance
DATABASE_URL="postgresql://user:password@host:5432/jobscraper"

# Redis - Required
# For caching and deduplication
REDIS_URL="redis://localhost:6379"

# Google Drive - Optional
# For cloud CSV uploads (see docs/GOOGLE_DRIVE_SETUP.md)
GOOGLE_DRIVE_FOLDER_ID=""
