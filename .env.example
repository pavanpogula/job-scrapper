# Database - Required
# Neon PostgreSQL instance with pgBouncer connection pooling for serverless environments
# Example: postgresql://[user]:[password]@[host]-pooler.[region].neon.tech/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/jobscraper?sslmode=require"

# Redis - Optional
# Upstash Redis for generation-based read-through caching and deduplication.
# If omitted or unconfigured, the backend API serves queries directly from PostgreSQL with dbGuard backpressure.
REDIS_URL="rediss://default:password@host.upstash.io:6379"

# API & Security - Optional
CORS_ORIGINS="https://job-scrapper-ui.vercel.app,http://localhost:3000"
HEALTH_TOKEN=""

# Cloud / CI (Optional)
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""
# GOOGLE_DRIVE_FOLDER_ID=""
