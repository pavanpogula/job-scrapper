{
  "name": "backend",
  "version": "0.1.0",
  "description": "Batch TypeScript CLI scraper for Ashby ATS feeding Neon PostgreSQL & Upstash Redis, Express REST API on Vercel.",
  "scripts": {
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "contract:fixtures": "UPDATE_CONTRACT_FIXTURES=1 jest tests/contract/ContractFixtures.test.ts",
    "seed": "npx ts-node src/utils/Seed.ts",
    "discover": "npx ts-node src/discovery/CdxWorker.ts",
    "scrape": "npx ts-node src/core/Scraper.ts",
    "scrape:parallel": "npx ts-node src/core/ClusterScraper.ts",
    "scrape:csv": "npx ts-node src/core/ScraperCSV.ts",
    "db:clean": "npx ts-node src/database/DbClean.ts",
    "db:backfill-source": "npx ts-node src/database/BackfillSource.ts",
    "db:inspect": "npx ts-node src/database/DbInspect.ts",
    "db:menu": "npx ts-node src/database/DbMenu.ts",
    "enrich:companies": "npx ts-node src/utils/EnrichCompanies.ts",
    "prisma:studio": "npx prisma studio",
    "docs:generate": "npx ts-node scripts/GenerateDocs.ts",
    "docs:check": "npm run docs:generate && git diff --exit-code -I 'Auto-generated on' -- docs/",
    "lint": "npx eslint src/ api/ tests/ scripts/ --ext .ts",
    "lint:fix": "npx eslint src/ api/ tests/ scripts/ --ext .ts --fix",
    "ratchet:any": "node scripts/any-ratchet.mjs",
    "ratchet:any:update": "node scripts/any-ratchet.mjs --update",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "check:all": "npm run build && npm run typecheck && npm run typecheck:test && npm run lint && node scripts/any-ratchet.mjs && npm test && npm run docs:check",
    "process:cdx": "npx ts-node src/utils/ProcessCdxData.ts",
    "db:normalize-countries": "npx ts-node src/database/NormalizeCountries.ts",
    "report:classify": "npx ts-node src/utils/ReportClassifyCli.ts",
    "report:install-fixture": "npx ts-node src/utils/InstallReportFixture.ts",
    "verify": "npx ts-node src/utils/Verify.ts",
    "cache:publish": "npx ts-node src/cache/CacheCli.ts publish",
    "cache:status": "npx ts-node src/cache/CacheCli.ts status",
    "cache:purge-legacy": "npx ts-node src/cache/CacheCli.ts purge-legacy",
    "api:start": "npx ts-node src/api/Server.ts",
    "build": "npx prisma generate"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "googleapis": "^169.0.0",
    "ioredis": "^5.8.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^46.10.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15"
  }
}
